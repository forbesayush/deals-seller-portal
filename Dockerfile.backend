FROM python:3.11-slim

WORKDIR /app

# Install system dependencies for build
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy and install Python requirements
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code
COPY src/ /app/src/

# Expose FastAPI port
EXPOSE 5000

# Default worker concurrency for high-concurrency request scaling
ENV WEB_CONCURRENCY=4

# Run FastAPI via uvicorn with multi-worker scaling
CMD ["sh", "-c", "uvicorn src.core.controller:app --host 0.0.0.0 --port 5000 --workers ${WEB_CONCURRENCY:-4}"]
